<Window x:Class="Aurix.Desktop.ActiveOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="126" Height="148" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" IsHitTestVisible="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse x:Name="OuterGlow" Width="86" Height="86" Fill="#2637BFFF" Opacity="0.42">
        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse x:Name="Ring" Width="74" Height="74" Stroke="#8AD8FF" StrokeThickness="1.5" Opacity="0.82"/>
      <Ellipse x:Name="Core" Width="58" Height="58">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.25">
            <GradientStop Color="#F4FFFFFF" Offset="0"/>
            <GradientStop Color="#FF74D9FF" Offset="0.28"/>
            <GradientStop Color="#FF347BFF" Offset="0.68"/>
            <GradientStop Color="#FF152C8A" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><DropShadowEffect Color="#5BCBFF" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="16" Height="8" Fill="#BFFFFFFF" Opacity="0.75"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,17,0,0">
        <Ellipse.RenderTransform><RotateTransform Angle="-28"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>
    <Border Grid.Row="1" HorizontalAlignment="Center" Background="#E90A1728"
            BorderBrush="#557ACBFF" BorderThickness="1" CornerRadius="11" Padding="9,4">
      <StackPanel>
        <TextBlock x:Name="StateText" Text="AURIX" Foreground="#F3FAFF"
                   FontSize="10" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock x:Name="HintText" Text="Listening" Foreground="#9CCEFF"
                   FontSize="8" TextAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>