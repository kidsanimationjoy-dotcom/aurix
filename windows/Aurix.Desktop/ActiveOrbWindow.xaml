<Window x:Class="Aurix.Desktop.ActiveOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="92" Height="104" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" IsHitTestVisible="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="76"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Width="72" Height="72" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse x:Name="OuterGlow" Width="68" Height="68" Opacity="0.48">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.42,0.36">
            <GradientStop Color="#A5F8FFFF" Offset="0"/>
            <GradientStop Color="#806B7CFF" Offset="0.52"/>
            <GradientStop Color="#006A38FF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse x:Name="Ring" Width="60" Height="60" StrokeThickness="2" Opacity="0.9">
        <Ellipse.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9CFBFF" Offset="0"/>
            <GradientStop Color="#71A7FF" Offset="0.28"/>
            <GradientStop Color="#D58AFF" Offset="0.56"/>
            <GradientStop Color="#FF9BCB" Offset="0.78"/>
            <GradientStop Color="#FFC58B" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Stroke>
      </Ellipse>
      <Ellipse x:Name="Core" Width="48" Height="48">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.28,0.22">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FF9DF8FF" Offset="0.20"/>
            <GradientStop Color="#FF64BFFF" Offset="0.39"/>
            <GradientStop Color="#FF8C83FF" Offset="0.60"/>
            <GradientStop Color="#FFE48CFF" Offset="0.78"/>
            <GradientStop Color="#FFFFB5A4" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect>
          <DropShadowEffect Color="#A58BFF" BlurRadius="18" ShadowDepth="0" Opacity="0.92"/>
        </Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="15" Height="7" Fill="#DFFFFFFF" Opacity="0.82"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
        <Ellipse.RenderTransform><RotateTransform Angle="-28"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>
    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0">
      <TextBlock x:Name="StateText" Text="AURIX" Foreground="#F3FAFF"
                 FontSize="8" FontWeight="Bold" TextAlignment="Center"/>
      <TextBlock x:Name="HintText" Text="Listening" Foreground="#BBDFFF"
                 FontSize="7" TextAlignment="Center" Margin="0,1,0,0"/>
    </StackPanel>
  </Grid>
</Window>