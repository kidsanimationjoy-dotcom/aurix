<Window x:Class="Aurix.Desktop.ActiveOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="190" Height="220" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" IsHitTestVisible="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Width="142" Height="142" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse x:Name="OuterGlow" Width="138" Height="138" Fill="#2637BFFF" Opacity="0.42">
        <Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse x:Name="Ring" Width="118" Height="118" Stroke="#8AD8FF" StrokeThickness="2" Opacity="0.82"/>
      <Ellipse x:Name="Core" Width="92" Height="92">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.25">
            <GradientStop Color="#F4FFFFFF" Offset="0"/>
            <GradientStop Color="#FF74D9FF" Offset="0.28"/>
            <GradientStop Color="#FF347BFF" Offset="0.68"/>
            <GradientStop Color="#FF152C8A" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><DropShadowEffect Color="#5BCBFF" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
      </Ellipse>
      <Ellipse Width="25" Height="12" Fill="#BFFFFFFF" Opacity="0.75"
               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,27,0,0">
        <Ellipse.RenderTransform><RotateTransform Angle="-28"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>
    <Border Grid.Row="1" HorizontalAlignment="Center" Background="#E90A1728"
            BorderBrush="#557ACBFF" BorderThickness="1" CornerRadius="14" Padding="13,6">
      <StackPanel>
        <TextBlock x:Name="StateText" Text="AURIX" Foreground="#F3FAFF"
                   FontSize="12" FontWeight="Bold" TextAlignment="Center"/>
        <TextBlock x:Name="HintText" Text="Listening" Foreground="#9CCEFF"
                   FontSize="10" TextAlignment="Center" Margin="0,2,0,0"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>