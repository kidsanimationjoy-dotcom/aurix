<Window x:Class="Aurix.Desktop.ActiveOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="166" Height="184" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize" IsHitTestVisible="False">
  <Grid ClipToBounds="False">
    <Grid.RowDefinitions>
      <RowDefinition Height="146"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- A compact, Siri-inspired liquid-light sphere: soft colour at the edge,
         luminous centre, and translucent colour fields that drift while active. -->
    <Grid Width="140" Height="140" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Ellipse x:Name="OuterGlow" Width="138" Height="138" Opacity="0.58">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.50,0.48">
            <GradientStop Color="#C9F5FFFF" Offset="0"/>
            <GradientStop Color="#A77FAFFF" Offset="0.42"/>
            <GradientStop Color="#7E5F7BFF" Offset="0.68"/>
            <GradientStop Color="#006B45FF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="19"/></Ellipse.Effect>
      </Ellipse>

      <Ellipse x:Name="Ring" Width="122" Height="122" StrokeThickness="1.4" Opacity="0.42">
        <Ellipse.Stroke>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#D5FFFFFF" Offset="0"/>
            <GradientStop Color="#8D9DFF" Offset="0.30"/>
            <GradientStop Color="#EE8FFF" Offset="0.62"/>
            <GradientStop Color="#FFFFBE91" Offset="1"/>
          </LinearGradientBrush>
        </Ellipse.Stroke>
      </Ellipse>

      <Ellipse x:Name="Core" Width="106" Height="106">
        <Ellipse.Fill>
          <RadialGradientBrush Center="0.42,0.34" GradientOrigin="0.28,0.20" RadiusX="0.78" RadiusY="0.82">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#FFBDFBFF" Offset="0.13"/>
            <GradientStop Color="#FF70D7FF" Offset="0.31"/>
            <GradientStop Color="#FF687DFF" Offset="0.53"/>
            <GradientStop Color="#FFD47BFF" Offset="0.75"/>
            <GradientStop Color="#FFFFA7B8" Offset="0.90"/>
            <GradientStop Color="#FFE779A8" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect>
          <DropShadowEffect Color="#A47CFF" BlurRadius="24" ShadowDepth="0" Opacity="0.78"/>
        </Ellipse.Effect>
      </Ellipse>

      <Ellipse x:Name="FlowA" Width="94" Height="54" Opacity="0.50">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.32,0.35">
            <GradientStop Color="#F2FFFFFF" Offset="0"/>
            <GradientStop Color="#C4A9FFFF" Offset="0.37"/>
            <GradientStop Color="#8A6FCFFF" Offset="0.68"/>
            <GradientStop Color="#0067BFFF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="13"/></Ellipse.Effect>
      </Ellipse>

      <Ellipse x:Name="FlowB" Width="70" Height="96" Opacity="0.42">
        <Ellipse.Fill>
          <RadialGradientBrush GradientOrigin="0.68,0.70">
            <GradientStop Color="#E8FFFFFF" Offset="0"/>
            <GradientStop Color="#D1A5EFFF" Offset="0.34"/>
            <GradientStop Color="#A66EBBFF" Offset="0.66"/>
            <GradientStop Color="#0078B7FF" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
        <Ellipse.Effect><BlurEffect Radius="15"/></Ellipse.Effect>
      </Ellipse>

      <Ellipse Width="42" Height="18" Fill="#EFFFFFFF" Opacity="0.70"
               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="34,23,0,0">
        <Ellipse.Effect><BlurEffect Radius="7"/></Ellipse.Effect>
        <Ellipse.RenderTransform><RotateTransform Angle="-28"/></Ellipse.RenderTransform>
      </Ellipse>
    </Grid>

    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,-1,0,0">
      <TextBlock x:Name="StateText" Text="AURIX" Foreground="#F5FAFF"
                 FontSize="12" FontWeight="SemiBold" TextAlignment="Center"/>
      <TextBlock x:Name="HintText" Text="Listening" Foreground="#C9D9FF"
                 FontSize="10" TextAlignment="Center" Margin="0,1,0,0"/>
    </StackPanel>
  </Grid>
</Window>