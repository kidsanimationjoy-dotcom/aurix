<Window x:Class="Aurix.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AURIX Desktop" Height="560" Width="820"
        MinHeight="480" MinWidth="700"
        Background="#0B1220" Foreground="#E8F0FF"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="AURIX" FontSize="34" FontWeight="Bold" Foreground="#70C7FF"/>
      <TextBlock Text="Your local Windows assistant" FontSize="15" Foreground="#A9B9D2" Margin="0,2,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#14233A" CornerRadius="12" Padding="18" Margin="0,24,0,18">
      <StackPanel>
        <TextBlock Text="LOCAL SECURITY STATUS" FontSize="12" FontWeight="SemiBold" Foreground="#8EA6C7"/>
        <TextBlock x:Name="DefenderStatusText" Text="Checking Microsoft Defender…" FontSize="19" Margin="0,8,0,0"/>
        <TextBlock x:Name="DefenderDetailsText" Text="AURIX uses Microsoft Defender for antivirus protection." Foreground="#A9B9D2" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
          <Button x:Name="RefreshButton" Content="Refresh status" Click="RefreshButton_Click" Padding="16,9" Margin="0,0,10,0"/>
          <Button x:Name="ScanButton" Content="Start quick scan" Click="ScanButton_Click" Padding="16,9"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#101B2D" CornerRadius="12" Padding="18">
      <StackPanel>
        <TextBlock Text="DESKTOP COMPANION FOUNDATION" FontSize="12" FontWeight="SemiBold" Foreground="#8EA6C7"/>
        <TextBlock Text="AURIX is installed as a Windows desktop process and stays available from the system tray. This first build establishes the native shell and Defender integration." TextWrapping="Wrap" FontSize="15" Margin="0,12,0,16"/>
        <TextBlock Text="Coming in the next implementation stages" FontWeight="SemiBold" Foreground="#70C7FF"/>
        <TextBlock Text="• Local clap and wake-phrase activation&#10;• Permission-based screen understanding and UI Automation&#10;• Hybrid local/cloud reasoning&#10;• Security event monitoring and task history" TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0"/>
        <TextBlock x:Name="ActivityText" Text="Ready. AURIX has not started microphone capture or computer-control actions." Foreground="#A9B9D2" TextWrapping="Wrap" Margin="0,18,0,0"/>
      </StackPanel>
    </Border>

    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock Text="AURIX runs with your Windows user permissions." Foreground="#8EA6C7" VerticalAlignment="Center"/>
      <Button Content="Enable start with Windows" DockPanel.Dock="Right" Click="StartupButton_Click" Padding="14,8"/>
    </DockPanel>
  </Grid>
</Window>
